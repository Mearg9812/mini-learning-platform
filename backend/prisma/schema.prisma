// This tells Prisma we are using PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// This tells Prisma to generate JavaScript code for us to use
generator client {
  provider = "prisma-client-js"
}

// An ENUM is a strict list of choices. A user can ONLY be a USER or ADMIN.
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

// This is another strict list. The active video source MUST be one of these two.
enum Source {
  YOUTUBE
  CLOUDFLARE
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LearningCourse {
  FREE_FOR_ALL
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
  FRESHMAN
  UNASSIGNED
}

enum PurchaseOption {
  FULL_ACCESS
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
  FRESHMAN
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// The "model" is our Database Table (like a spreadsheet tab).
model User {
  // Every user gets a unique random string ID (uuid)
  id String @id @default(uuid())

  // They need an email, and @unique means no two users can have the same email
  email String? @unique

  name  String @default("")
  phone String?

  // We will store their scrambled password here
  password String

  // The '?' means this is optional. They don't HAVE to upload an image right away
  profileImage String?

  // By default, everyone who signs up is a regular USER
  role Role @default(USER)

  // Existing accounts require review before accessing the learning library.
  status EnrollmentStatus @default(PENDING)

  paymentRequests PaymentRequest[] @relation("StudentPayments")
  reviewedPayments PaymentRequest[] @relation("PaymentReviewer")
  notificationReads NotificationRead[]

  // Automatically saves the exact time they signed up
  createdAt DateTime @default(now())
}

// Our new Video Database Table
model Video {
  id          String @id @default(uuid())
  title       String
  description String
  category    String
  duration    Int // We will store the duration in seconds (e.g., 120 for 2 mins)
  thumbnail   String // A URL link to the image

  // The requirements state BOTH sources are mandatory when creating a video
  youtubeUrl    String
  cloudflareUrl String

  // The admin can switch this instantly. By default, let's say it's YouTube.
  activeSource Source @default(YOUTUBE)

  course LearningCourse @default(UNASSIGNED)

  createdAt DateTime @default(now())
}

model PaymentRequest {
  id               String         @id @default(uuid())
  userId           String
  option           PurchaseOption
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @db.VarChar(3)
  receiptText      String?        @db.Text
  receiptObjectKey String?
  status           PaymentStatus  @default(PENDING)
  approvedOption   PurchaseOption?
  adminNote        String?        @db.Text
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())

  user       User  @relation("StudentPayments", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
}

model NotificationMessage {
  id        String             @id @default(uuid())
  title     String             @db.VarChar(120)
  body      String             @db.Text
  createdAt DateTime           @default(now())
  reads     NotificationRead[]

  @@index([createdAt])
}

model NotificationRead {
  notificationId String
  userId         String
  readAt         DateTime           @default(now())
  notification   NotificationMessage @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
}
